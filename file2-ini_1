#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Excel 加工表 (site / role / output 三列) -> Ansible INI inventory
表结构:
    A列 表头 site   : 站点码 (bej / cct / az2 ...)
    B列 表头 role   : 角色码 (lan / wan / wln)
    C列 表头 output : 完整主机行, 如 "cnbej-wlnlap005 ansible_host=158.33.222.131 site=bej role=wln"
    D列 忽略

用法:
    python3 cmdb2ini.py 表.xlsx
    python3 cmdb2ini.py 表.xlsx -o 01_network_inventory.ini --sheet Sheet1
    python3 cmdb2ini.py 表.csv

依赖: pip install pandas openpyxl --break-system-packages
"""

import argparse
import sys
from datetime import date

import pandas as pd

COL_SITE = "site"
COL_ROLE = "role"
COL_OUT = "output"


def parse_args():
    p = argparse.ArgumentParser(description="site/role/output 表 -> Ansible INI inventory")
    p.add_argument("input", help="Excel 或 CSV 文件")
    p.add_argument("-o", "--output", default="01_network_inventory.ini")
    p.add_argument("--sheet", default=0, help="Excel sheet 名或序号, 默认第一个")
    return p.parse_args()


def load(path, sheet):
    if path.lower().endswith((".xlsx", ".xlsm", ".xls")):
        df = pd.read_excel(path, sheet_name=sheet, dtype=str)
    else:
        df = pd.read_csv(path, dtype=str, encoding="utf-8-sig")
    df.columns = [str(c).strip().lower() for c in df.columns]
    missing = [c for c in (COL_SITE, COL_ROLE, COL_OUT) if c not in df.columns]
    if missing:
        sys.exit(f"错误: 找不到列 {missing}。实际列名: {list(df.columns)}")
    return df


def main():
    args = parse_args()
    df = load(args.input, args.sheet)
    total_rows = len(df)

    # --- 清洗 ---
    for c in (COL_SITE, COL_ROLE, COL_OUT):
        df[c] = df[c].fillna("").str.strip()
    df = df[(df[COL_SITE] != "") & (df[COL_ROLE] != "") & (df[COL_OUT] != "")].copy()
    df[COL_SITE] = df[COL_SITE].str.lower()
    df[COL_ROLE] = df[COL_ROLE].str.lower()

    # 从 output 拆主机名和 ansible_host, 主机名统一小写
    def split_out(line):
        parts = line.split()
        name = parts[0].lower()
        ip = ""
        for p in parts[1:]:
            if p.lower().startswith("ansible_host="):
                ip = p.split("=", 1)[1]
                break
        return name, ip

    df[["_name", "_ip"]] = df[COL_OUT].apply(lambda s: pd.Series(split_out(s)))

    no_ip = df[df["_ip"] == ""]
    if not no_ip.empty:
        print(f"[警告] {len(no_ip)} 行 output 里没有 ansible_host=, 已剔除:", file=sys.stderr)
        for n in no_ip["_name"]:
            print(f"    {n}", file=sys.stderr)
    df = df[df["_ip"] != ""]

    # 堆叠成员去重: 同 IP 保留名字最短的主名
    df["_len"] = df["_name"].str.len()
    df = (
        df.sort_values(["_ip", "_len", "_name"])
          .drop_duplicates(subset=["_ip"], keep="first")
          .drop(columns="_len")
    )

    # 同名不同 IP 冲突检测
    dup = df[df.duplicated(subset=["_name"], keep=False)]
    if not dup.empty:
        print("[警告] 主机名重复但 IP 不同, 请人工确认:", file=sys.stderr)
        for _, r in dup.iterrows():
            print(f"    {r['_name']}  {r['_ip']}", file=sys.stderr)

    df = df.sort_values([COL_SITE, COL_ROLE, "_name"]).reset_index(drop=True)

    # --- 生成 INI ---
    lines = [
        f"; Generated by cmdb2ini.py on {date.today().isoformat()}",
        f"; Source: {args.input}  ({total_rows} rows -> {len(df)} hosts)",
        "",
        "[all]",
    ]
    # [all] 段: 主机名(小写) + ansible_host, 不带 site=/role= (组结构已表达)
    for _, r in df.iterrows():
        lines.append(f"{r['_name']} ansible_host={r['_ip']}")

    for site, sdf in df.groupby(COL_SITE, sort=True):
        lines += ["", f";=== {site.upper()} ==="]
        for role, g in sdf.groupby(COL_ROLE, sort=True):
            lines += [f"[site_{site}_{role}]"]
            lines += g["_name"].tolist()
            lines.append("")
        lines += [f"[site_{site}:children]"]
        lines += [f"site_{site}_{r}" for r in sorted(sdf[COL_ROLE].unique())]

    lines += ["", ";=== roles ==="]
    for role in sorted(df[COL_ROLE].unique()):
        lines += [f"[{role}:children]"]
        lines += sorted(f"site_{s}_{role}" for s in df[df[COL_ROLE] == role][COL_SITE].unique())
        lines.append("")

    with open(args.output, "w", encoding="utf-8", newline="\n") as f:
        f.write("\n".join(lines).rstrip() + "\n")

    print(f"完成: {args.output}")
    print(f"  主机: {len(df)}")
    print(f"  站点: {df[COL_SITE].nunique()}  ({', '.join(sorted(df[COL_SITE].unique()))})")
    print(f"  角色: {df[COL_ROLE].nunique()}  ({', '.join(sorted(df[COL_ROLE].unique()))})")
    print("验证: ansible-inventory -i", args.output, "--graph")


if __name__ == "__main__":
    main()
